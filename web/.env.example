# Copy to .env.local and fill in from `firebase apps:sdkconfig WEB <appId>`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local development: App Check debug token added in Firebase console → App Check → Apps → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
# Production: score-based reCAPTCHA key (Google Cloud Fraud Defense, formerly reCAPTCHA Enterprise)
# in this Firebase project, registered for the web app in App Check.
VITE_RECAPTCHA_SITE_KEY=
